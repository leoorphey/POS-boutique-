{
  "name": "pos-boutique-informatique",
  "private": true,
  "version": "1.0.0",
  "description": "Application POS complète pour boutique informatique",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev:shared": "npm run dev --workspace=shared",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build:shared": "npm run build --workspace=shared",
    "build": "npm run build:shared && npm run build:server && npm run build:client",
    "postinstall": "npm run build:shared",
    "test:server": "npm run test --workspace=server",
    "test:client": "npm run test --workspace=client",
    "test": "npm run test:server && npm run test:client",
    "prisma:generate": "npm run prisma:generate --workspace=server",
    "prisma:migrate": "npm run prisma:migrate --workspace=server",
    "prisma:studio": "npm run prisma:studio --workspace=server",
    "prisma:seed": "npm run prisma:seed --workspace=server"
  },
  "prisma": {
    "seed": "npm run prisma:seed --workspace=server"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
