# --- Base de données ---
# Local (docker-compose) :
# DATABASE_URL="postgresql://pos_user:pos_password@localhost:5432/pos_boutique?schema=public"
# Production (Supabase) : récupérer la connection string dans Project Settings > Database
DATABASE_URL=""

# --- Serveur ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# --- JWT ---
JWT_ACCESS_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET=""
JWT_REFRESH_EXPIRES_IN="7d"

# --- PayDunya (paiement) ---
PAYDUNYA_MASTER_KEY=""
PAYDUNYA_PRIVATE_KEY=""
PAYDUNYA_PUBLIC_KEY=""
PAYDUNYA_TOKEN=""
PAYDUNYA_MODE="sandbox"
PAYDUNYA_SUCCESS_URL="http://localhost:5173/pos/paydunya/success"
PAYDUNYA_CANCEL_URL="http://localhost:5173/pos/paydunya/cancel"
PAYDUNYA_IPN_URL="http://localhost:4000/api/v1/payments/paydunya/ipn"

# --- Email (Nodemailer) ---
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="POS Boutique <no-reply@boutique.com>"
OWNER_EMAIL=""

# --- Boutique ---
SHOP_NAME="Ma Boutique Informatique"
SHOP_ADDRESS="Dakar, Sénégal"
SHOP_PHONE=""
