// ==========================================================
// Schéma Prisma - POS Boutique Informatique
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------
// ENUMS
// (doivent rester synchronisés avec shared/src/types/enums.ts)
// ----------------------------------------------------------

enum Role {
  ADMIN
  VENDEUR
}

enum PaymentMethod {
  PAYDUNYA
  ESPECES
  NEGOCIE
}

enum SaleStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum StockMovementType {
  ENTREE
  SORTIE
  AJUSTEMENT
}

// ----------------------------------------------------------
// UTILISATEURS & AUTH
// ----------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  nom          String
  email        String   @unique
  password     String // hash bcrypt
  passwordChangedAt DateTime?
  failedLoginAttempts Int @default(0)
  lockedUntil DateTime?
  resetPasswordToken String? @unique
  resetPasswordExpires DateTime?
  resetPasswordRequestedAt DateTime?
  resetPasswordUsedAt DateTime?
  role         Role     @default(VENDEUR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  sales         Sale[]
  stockMovements StockMovement[]
  auditLogs     AuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique // hash du refresh token, jamais le token brut
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ----------------------------------------------------------
// CATÉGORIES
// ----------------------------------------------------------

model Category {
  id          String    @id @default(cuid())
  nom         String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("categories")
}

// ----------------------------------------------------------
// PRODUITS
// ----------------------------------------------------------

model Product {
  id             String   @id @default(cuid())
  nom            String
  marque         String
  modele         String
  categorieId    String
  categorie      Category @relation(fields: [categorieId], references: [id], onDelete: Restrict)

  ram            String? // ex: "8GB"
  stockage       String? // ex: "256GB"
  couleur        String?
  imei           String?  @unique
  numeroSerie    String?  @unique

  prixAchat      Decimal  @db.Decimal(12, 2)
  prixVente      Decimal  @db.Decimal(12, 2)
  quantiteStock  Int      @default(0)

  description    String?
  image          String? // URL ou chemin du fichier

  isActive       Boolean  @default(true) // soft delete : un produit vendu reste consultable

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stockMovements StockMovement[]
  saleItems      SaleItem[]

  @@index([nom, marque, modele])
  @@index([imei])
  @@index([numeroSerie])
  @@index([categorieId])
  @@map("products")
}

// ----------------------------------------------------------
// MOUVEMENTS DE STOCK
// ----------------------------------------------------------

model StockMovement {
  id         String            @id @default(cuid())
  productId  String
  product    Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  type       StockMovementType
  quantity   Int
  reason     String? // ex: "Vente #REF-001", "Réception fournisseur"
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt  DateTime          @default(now())

  @@index([productId])
  @@index([createdAt])
  @@map("stock_movements")
}

// ----------------------------------------------------------
// VENTES
// ----------------------------------------------------------

model Sale {
  id               String        @id @default(cuid())
  reference        String        @unique // ex: VTE-2026-000123

  customerName     String?
  customerPhone    String?

  sellerId         String
  seller           User          @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  paymentMethod    PaymentMethod

  subtotal         Decimal       @db.Decimal(12, 2)
  discount         Decimal       @default(0) @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)

  // Paiement espèces
  montantRecu      Decimal?      @db.Decimal(12, 2)
  monnaieARendre   Decimal?      @db.Decimal(12, 2)

  // Paiement négocié
  prixOriginal     Decimal?      @db.Decimal(12, 2)
  prixNegocie      Decimal?      @db.Decimal(12, 2)
  negotiatedPaymentMethod String?

  // Paiement PayDunya
  paydunyaReference    String?       @unique
  paydunyaInvoiceUrl   String?
  paydunyaQrCodeData   String? // données encodées dans le QR Code (facultatif)
  paydunyaPaidAt       DateTime?

  status           SaleStatus    @default(PENDING)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  items            SaleItem[]

  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id           String   @id @default(cuid())
  saleId       String
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Copie figée au moment de la vente : reste correct même si le produit change ensuite
  imei         String?
  serialNumber String?
  productName  String
  productBrand String

  quantity     Int
  unitPrice    Decimal  @db.Decimal(12, 2)
  total        Decimal  @db.Decimal(12, 2)

  createdAt    DateTime @default(now())

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

// ----------------------------------------------------------
// AUDIT LOG
// ----------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // ex: "CREATE_PRODUCT", "DELETE_USER", "VALIDATE_PAYMENT"
  entity    String // ex: "Product", "Sale", "User"
  entityId  String?
  meta      Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
